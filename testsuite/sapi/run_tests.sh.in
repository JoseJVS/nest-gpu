#!/bin/bash

set -euxo pipefail

use_mpi="@USE_MPI@"
mpi_executable="@MPIEXEC_EXECUTABLE@"
mpi_np_flag="@MPIEXEC_NUMPROC_FLAG@"
mpi_pre_exec_flag="@MPIEXEC_PREFLAGS@"
mpi_post_exec_flag="@MPIEXEC_POSTFLAGS@"
mpi_max_procs="@MPIEXEC_MAX_NUMPROCS@"

all_tests="@ALL_TESTS@"

# Tests with oversized inputs run in a subshell with a virtual memory limit
# (inherited by the MPI launcher and every process it starts)
memory_capped_tests="@MEMORY_CAPPED_TESTS@"
memory_cap_kb="@SAPI_TEST_MEMORY_CAP_KB@"

run_test() {
    local test="$1"
    shift
    if [[ " ${memory_capped_tests} " == *" ${test} "* ]]; then
        (ulimit -v "${memory_cap_kb}" && "$@")
    else
        "$@"
    fi
}

if [[ "${use_mpi}" == "false" ]]; then
    for test in ${all_tests}; do
        run_test ${test} ${test}
    done
else
    for test in ${all_tests}; do
        run_test ${test} ${mpi_executable} ${mpi_np_flag} 1 ${mpi_pre_exec_flag} ${test} ${mpi_post_exec_flag}
    done

    mpi_tests="@MPI_TESTS@"

    if [ ! -z "${mpi_max_procs}" ]; then
        if [ "4" -lt "${mpi_max_procs}" ]; then
            # Limit the maximum number of processes used to 4
            mpi_max_procs=4
        else if [ "${mpi_max_procs}" -lt "2" ]; then
                # If the maximum is less than two then empty the variable
                mpi_max_procs=""
            fi
        fi
    else
            # If no information about the maximum number of processes then default to 4
            mpi_max_procs=4
    fi

    # Condition is only false if the maximum number of processes is less than 2
    if [ ! -z "${mpi_max_procs}" ]; then
        for test in ${mpi_tests}; do
            for np in $(seq 2 ${mpi_max_procs}); do
                run_test ${test} ${mpi_executable} ${mpi_np_flag} ${np} ${mpi_pre_exec_flag} ${test} ${mpi_post_exec_flag}
            done
        done
    fi
fi
